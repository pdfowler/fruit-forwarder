{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pdfowler/fruit-forwarder",
  "title": "Fruit Forwarder MCP",
  "description": "Scoped local MCP access to Apple Reminders and read-only Calendar data via macOS EventKit.",
  "repository": {
    "url": "https://github.com/pdfowler/fruit-forwarder",
    "source": "github"
  },
  "version": "@@VERSION@@",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "@@MCPB_URL@@",
      "version": "@@VERSION@@",
      "fileSha256": "@@MCPB_SHA256@@",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
